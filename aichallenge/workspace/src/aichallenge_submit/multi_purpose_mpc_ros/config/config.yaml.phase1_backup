common:
  save_config: false

sim_logger:
  animation_enabled: false

map:
  # path from pkg share dir
  yaml_path: "env/final_ver3/occupancy_grid_map.yaml"

waypoints:
  # path from pkg share dir
  # csv_path: "maps/occupancy_grid_map_waypoints.csv"
  csv_path: ""

obstacles:
  # path from pkg share dir
  csv_path: "" # If empty, the obstacles information will be subscribed from the topic
  # csv_path: "maps/occupancy_grid_map_obstacles.csv"
  radius: 1.25

reference_path:
  update_by_topic: false # When true, 'circle' must be false
  # path from pkg share dir
  # csv_path: ""
  csv_path: "env/final_ver3/traj_mincurv.csv"
  resolution: 0.5  # Increased resolution for smoother path following
  smoothing_distance: 3  # Increased smoothing for curve stability
  max_width: 6.0
  circular: true
  use_path_constraints_topic: false
  use_border_cells_topic: false
  # use_path_constraints_topic: true
  # use_border_cells_topic: true

bicycle_model:
  length: 1.087
  # width: 1.45   # real machine width
  width: 2.50   # Increased safety margin to prevent crashing

mpc:
  N: 30   # Increased horizon for better lookahead and smoother planning
  # Q: [e_y, e_psi, t]
  # R: [v, delta]
  # QN: [e_y, e_psi, t]
  R: [100000.0, 20000.0]  # Reduced steering penalty for smoother transitions
  a_min: -4.0 # m/s^2 (stronger braking for high-speed)
  a_max: 2.5 # m/s^2 (increased acceleration for high-speed target)
  delta_max_deg: 32.0 # degrees
  steer_rate_max: 0.30 # rad/s (reduced for smoother steering transitions)
  control_rate: 40.0 # Hz
  steering_tire_angle_gain_var: 1.639
  accel_low_pass_gain: 0.7  # Slightly reduced for quicker response
  steer_low_pass_gain: 0.25  # Reduced for smoother steering (more filtering)
  wp_id_offset: 2
  use_max_kappa_pred: true
  raceline_blend_ratio: 0.9  # Slightly reduced for adaptive racing lines
  friction_coefficient: 0.95  # Increased for high-speed grip
  dynamic_acceleration: true  # Enable dynamic acceleration based on road conditions


  ## --- HIGH SPEED (30-35 km/h target, smoother curves) --- ##
  
  v_max: 32.0
  ay_max: 8.5
  Q: [2500000.0, 100000000.0, 100000.0]  # Increased heading weight for smooth orientation
  QN: [1000000.0, 1000.0, 10000.0]

  ## --- 高速 (gnss delay 0.4) --- ##
